<resources>
    <!-- Custom bottom-nav item: full-width tap target holding a content-hugging pill -->
    <style name="NavItemOuter">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>

    <style name="NavItemPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">8dp</item>
    </style>

    <!-- Screen header title -->
    <style name="ScreenTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingTop">32dp</item>
        <item name="android:textColor">@color/charcoal_ink</item>
        <item name="android:textSize">32sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <!-- Short sage accent bar under a screen title -->
    <style name="ScreenTitleAccent">
        <item name="android:layout_width">36dp</item>
        <item name="android:layout_height">4dp</item>
        <item name="android:layout_marginStart">20dp</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:background">@drawable/bg_accent_bar</item>
    </style>

    <!-- Screen header subtitle / count -->
    <style name="ScreenSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/muted_steel</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Rounded corners for the task-list thumbnail -->
    <style name="RoundedThumbnail" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <!-- Date / category filter chip: white rounded pill with sage icon+text -->
    <style name="FilterChipButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:textColor">@color/muted_sage</item>
        <item name="android:textSize">12sp</item>
        <item name="android:maxLines">1</item>
        <item name="cornerRadius">20dp</item>
        <item name="strokeColor">@color/whisper_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="backgroundTint">@color/pure_surface</item>
        <item name="rippleColor">@color/sage_wash</item>
        <item name="iconSize">16dp</item>
        <item name="iconPadding">4dp</item>
        <item name="iconTint">@color/muted_sage</item>
    </style>

    <!-- One segment of the status segmented control -->
    <style name="SegmentItem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">10dp</item>
        <item name="android:background">@drawable/bg_segment_item</item>
        <item name="android:textColor">@color/nav_pill_color</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Rounded pill shape for the active nav item indicator -->
    <style name="ShapeAppearance.Nav.ActiveIndicator" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">18dp</item>
    </style>

    <!-- Sage-tinted pill behind the selected bottom-nav item (Material 3 active indicator) -->
    <style name="Widget.Nav.ActiveIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/sage_wash</item>
        <item name="android:width">64dp</item>
        <item name="android:height">36dp</item>
        <item name="marginHorizontal">8dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.Nav.ActiveIndicator</item>
    </style>
</resources>
